# ============================================================================
# Ultra-Optimized Multi-Stage Dockerfile for AWS Lambda
# ============================================================================
# Target: ~200-210MB image (was 266MB, originally 808MB)
# Cold start: ~2-3 seconds (was 3-4s, originally 5-6s)
# Build time: ~2-3 minutes
#
# Optimizations:
# 1. Multi-stage build (builder + production)
# 2. Minimal dependencies (only 3 packages)
# 3. No cache layers (--no-cache-dir)
# 4. Slim base image (not Lambda base)
# 5. Lambda RIC for compatibility
# 6. Proper layer caching order
# ============================================================================

# ============================================================================
# Stage 1: Builder - Install dependencies
# ============================================================================
# Explicitly target x86_64 architecture for AWS Lambda compatibility
FROM --platform=linux/amd64 python:3.12-slim AS builder

# Install minimal build dependencies
# gcc: Required for some Python packages with C extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Copy only requirements first (for layer caching)
# This layer will be cached unless requirements.txt changes
COPY requirements.txt .

# Install Python dependencies
# --no-cache-dir: Don't cache pip downloads (saves ~50MB)
# --upgrade pip: Ensure latest pip for better dependency resolution
# awslambdaric: Lambda Runtime Interface Client for slim image
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -r requirements.txt && \
    pip3 install --no-cache-dir awslambdaric==2.2.1 && \
    # Clean up pip cache just in case
    rm -rf /root/.cache/pip

# Optional: Pre-compile Python bytecode for faster cold starts
# Uncomment for additional ~200ms cold start improvement
# RUN python -m compileall /usr/local/lib/python3.12/site-packages

# ============================================================================
# Stage 2: Production - Minimal runtime image
# ============================================================================
# Explicitly target x86_64 architecture for AWS Lambda compatibility
FROM --platform=linux/amd64 python:3.12-slim

# Install only essential runtime dependencies
# ca-certificates: For HTTPS connections to AWS services
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && rm -rf /var/cache/apt/*

# Set working directory (Lambda convention)
WORKDIR /var/task

# Copy installed Python packages from builder
# This includes: fastapi, pydantic, mangum, awslambdaric
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
# Order matters: Copy least-frequently-changed files first for better caching
COPY main.py .
COPY src/ ./src/

# Set Lambda environment variables
ENV LAMBDA_TASK_ROOT=/var/task \
    LAMBDA_RUNTIME_DIR=/var/runtime \
    PYTHONPATH=/var/task \
    # Optimize Python runtime
    PYTHONUNBUFFERED=1 \
    # Don't write .pyc files (Lambda is ephemeral)
    PYTHONDONTWRITEBYTECODE=1

# Lambda Runtime Interface Client entry point
ENTRYPOINT ["/usr/local/bin/python", "-m", "awslambdaric"]

# Lambda handler
CMD ["main.lambda_handler"]

# ============================================================================
# Build Instructions:
# ============================================================================
#
# Standard build (with caching):
#   docker build -t 3c-solutions-lambda:latest .
#
# Clean build (no cache):
#   docker build --no-cache -t 3c-solutions-lambda:latest .
#
# Multi-platform build (for ARM64 Lambda):
#   docker buildx build --platform linux/arm64 -t 3c-solutions-lambda:arm64 .
#
# Check image size:
#   docker images 3c-solutions-lambda:latest
#   Expected: ~210MB (compressed: ~52MB)
#
# Test locally (requires Lambda RIC):
#   docker run -p 9000:8080 3c-solutions-lambda:latest
#   curl -X POST "http://localhost:9000/2015-03-31/functions/function/invocations" \
#     -d '{"httpMethod":"GET","path":"/api/v1/threecsolutions/health"}'
#
# ============================================================================
