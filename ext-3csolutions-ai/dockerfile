# ====================
# Stage 1: Builder
# ====================
FROM python:3.11-slim AS builder

# Set build-time environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install dependencies in separate layer for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# ====================
# Stage 2: Runtime (Optimized)
# ====================
FROM python:3.11-slim AS runtime

# Metadata
LABEL maintainer="3C Solutions" \
      version="2.0.0" \
      description="Production Document Extraction Pipeline with Enhanced Security"

# Set runtime environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app"

# Install only essential runtime dependencies (if needed)
# Most Python apps don't need additional system packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create non-root user for security
RUN groupadd -r appuser && \
    useradd -r -g appuser -u 1001 -m -s /sbin/nologin appuser

# Set working directory
WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder --chown=appuser:appuser /opt/venv /opt/venv

# Copy application code
COPY --chown=appuser:appuser main.py .
COPY --chown=appuser:appuser healthcheck.py .
COPY --chown=appuser:appuser src/ ./src/

# Switch to non-root user
USER appuser

# Add healthcheck - validates AWS service connectivity
# Tests S3 bucket, DynamoDB table, and Bedrock access
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python healthcheck.py || exit 1

# Run the Fargate task handler (entry point)
CMD ["python", "-u", "main.py"]
